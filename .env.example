# Скопируйте в .env и при необходимости измените: cp .env.example .env

# --- PostgreSQL ---
POSTGRES_DB=worddeck
POSTGRES_USER=worddeck
# Только буквы и цифры: пароль подставляется в DATABASE_URL.
POSTGRES_PASSWORD=changeMePostgres123

# --- Backend ---
# Срок жизни сессии входа.
SESSION_TTL=720h
# Флаг Secure у cookie сессии. Локальный стенд работает по HTTP, поэтому false;
# в окружении с HTTPS — true.
COOKIE_SECURE=false
# LOG_LEVEL: debug | info | warn | error;  LOG_FORMAT: json | text
LOG_LEVEL=info
LOG_FORMAT=json
SHUTDOWN_TIMEOUT=15s
# Максимальный размер файла импорта в байтах; меньше NGINX_CLIENT_MAX_BODY_SIZE.
MAX_IMPORT_BYTES=1048576

# Таймауты HTTP-сервера
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=30s
HTTP_WRITE_TIMEOUT=60s
HTTP_IDLE_TIMEOUT=120s

# Пул соединений; DB_CONNECT_TIMEOUT — сколько ждать Postgres при старте
DB_MAX_OPEN_CONNS=10
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_IDLE_TIME=5m
DB_CONN_MAX_LIFETIME=30m
DB_CONNECT_TIMEOUT=30s

# --- Frontend (nginx) ---
# Максимальный размер запроса к API (загрузка файлов импорта)
NGINX_CLIENT_MAX_BODY_SIZE=2m
# Защита от перебора паролей (на IP): после NGINX_AUTH_BURST быстрых попыток
# входа и регистрации — не чаще NGINX_AUTH_RATE.
NGINX_AUTH_RATE=10r/m
NGINX_AUTH_BURST=20
FRONTEND_PORT=8090

# Тег образов и версия, вшиваемая в бинарник backend
APP_VERSION=1.0.0
